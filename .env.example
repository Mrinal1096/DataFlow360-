# =============================================================
# DataFlow360 — Environment Variables Template
# =============================================================
# INSTRUCTIONS:
# 1. Copy this file and rename the copy to: .env
# 2. Fill in YOUR real values in the .env file
# 3. NEVER commit your .env file to Git
# 4. This .env.example file IS safe to commit (no real secrets here)
# =============================================================

# --------------------------
# Project Settings
# --------------------------
PROJECT_NAME=DataFlow360
ENVIRONMENT=development

# --------------------------
# Database Settings (PostgreSQL)
# We will set these up in Phase 4
# --------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dataflow360
DB_USER=your_database_username_here
DB_PASSWORD=your_database_password_here

# --------------------------
# Data Source Settings
# --------------------------
# NASA PCoE Battery Dataset download URL
NASA_BATTERY_URL=https://phm-datasets.s3.amazonaws.com/NASA/5.+Battery+Data+Set.zip

# --------------------------
# Logging Settings
# --------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/dataflow360.log
